{
  "family": "payment-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "__ECS_EXECUTION_ROLE_ARN__",
  "taskRoleArn": "__ECS_TASK_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "payment-service",
      "image": "__IMAGE__",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8084,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "SERVER_PORT",
          "value": "8084"
        },
        {
          "name": "EUREKA_DEFAULT_ZONE",
          "value": "__EUREKA_DEFAULT_ZONE__"
        },
        {
          "name": "DB_HOST",
          "value": "__RDS_HOST__"
        },
        {
          "name": "DB_PORT",
          "value": "__RDS_PORT__"
        },
        {
          "name": "DB_USER",
          "value": "__RDS_USER__"
        },
        {
          "name": "DB_PASS",
          "value": "__RDS_PASSWORD__"
        },
        {
          "name": "DB_NAME",
          "value": "payment_db"
        },
        {
          "name": "KAFKA_BOOTSTRAP_SERVERS",
          "value": "__KAFKA_BOOTSTRAP_SERVERS__"
        },
        {
          "name": "IYZICO_BASE_URL",
          "value": "__IYZICO_BASE_URL__"
        },
        {
          "name": "IYZICO_API_KEY",
          "value": "__IYZICO_API_KEY__"
        },
        {
          "name": "IYZICO_SECRET_KEY",
          "value": "__IYZICO_SECRET_KEY__"
        },
        {
          "name": "PAYMENT_IYZIPAY_REQUIRE_REAL",
          "value": "true"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/payment-service",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}